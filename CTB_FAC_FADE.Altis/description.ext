// rsc scripts loaded via execVM in initServer.sqf (matches FinestHour/Tequila pattern)

// Surrender Challenge sounds (OGG files in Sounds/ folder)
class CfgSounds
{
    #include "rsc\CfgSoundsCutscene.inc.hpp"
    class FAC_surrenderAffirmative
    {
        name = "FAC_surrenderAffirmative";
        sound[] = {"\Sounds\affirmative.ogg", 2.5, 1, 500};
        titles[] = {};
    };
    class FAC_surrenderNegative
    {
        name = "FAC_surrenderNegative";
        sound[] = {"\Sounds\negative.ogg", 2.5, 1, 500};
        titles[] = {};
    };
    // Initial challenge shouts (Surrender Challenge audio; player path optional)
    class FAC_apprehend001 { name = "FAC_apprehend001"; sound[] = {"\Sounds\fac_apprehend-001.ogg", 2.5, 1, 500}; titles[] = {}; };
    class FAC_apprehend006 { name = "FAC_apprehend006"; sound[] = {"\Sounds\fac_apprehend-006.ogg", 2.5, 1, 500}; titles[] = {}; };
    class FAC_apprehend011 { name = "FAC_apprehend011"; sound[] = {"\Sounds\fac_apprehend-011.ogg", 2.5, 1, 500}; titles[] = {}; };
    // Troop transport: add FADE_embarkStart / FADE_embarkDone / FADE_disembarkStart / FADE_disembarkDone here when the matching OGGs exist in Sounds\ (TroopTransport.sqf skips playSound if absent)
    // CQB killhouse loudspeaker (Eden object cqbLoudspeaker; 3D origin +5 m above object in script)
    // Audio file from Sig_CTB_MSL_SFX_Amb (must be loaded on server/clients)
    class FAC_cqbLoudspeakerHorn
    {
        name = "FAC_cqbLoudspeakerHorn";
        sound[] = {"\Sig_CTB_MSL_SFX_Amb\Sounds\Alarm\alarm_2.ogg", 3, 1, 250};
        titles[] = {};
    };
};

