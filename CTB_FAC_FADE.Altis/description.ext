// Respawn: override mission.sqm to avoid respawn on mission start (no script calls forceRespawn).
// 0 = none; set to 3 in Eden for base respawn on death if desired.
respawn = 3;
respawnTemplates[] = { "Spectator" };
respawnOnStart = 0;

// ESC debug console (Splendid Camera + Spectator). Not lobby-tunable at runtime — use lobby param
// FAC_DebugTools for script Zeus self-assign (Scenario Admin tab). 2 = server admin in MP.
enableDebugConsole = 2;

// bis_fnc_cp_* stubs before Eden CP/CPE modules (see rsc\fn_bisCpPreInit.sqf)
#include "rsc\CfgFunctionsMission.hpp"

// Face's Dynamic Sandbox GUI -- base controls (import can fail with some mod combinations)
#include "rsc\BaseControls.hpp"
#include "rsc\FAC_Theme.hpp"
#include "rsc\FAC_DialogChrome.hpp"

// Display base -- must be defined before use (game class can be undefined with mod combos)
class RscDisplayEmpty { idd = -1; movingEnable = 1; enableSimulation = 1; };

#include "rsc\FAC_Terminal.hpp"


// Combo in nested dialog controls does not inherit mission RscCombo fields — use this base for combos under RscDisplay* (FIRES drill, Medical training, etc.).
class FACRscCombo: RscCombo {
    maxHistoryDelay = 0;
    shadow = 0;
    arrowEmpty = "\a3\ui_f\data\gui\cfg\scrollbar\arrowempty_ca.paa";
    arrowFull = "\a3\ui_f\data\gui\cfg\scrollbar\arrowfull_ca.paa";
    wholeHeight = 0.35;
    soundSelect[] = {"", 0, 0};
    soundExpand[] = {"", 0, 0};
    soundCollapse[] = {"", 0, 0};
    class ComboScrollBar {
        color[] = {1, 1, 1, 0.6};
        colorActive[] = {1, 1, 1, 1};
        colorDisabled[] = {1, 1, 1, 0.3};
        thumb = "\a3\ui_f\data\gui\cfg\scrollbar\thumb_ca.paa";
        arrowFull = "\a3\ui_f\data\gui\cfg\scrollbar\arrowfull_ca.paa";
        arrowEmpty = "\a3\ui_f\data\gui\cfg\scrollbar\arrowempty_ca.paa";
        border = 0;
        size = 0;
    };
};

// Vehicles — single dialog (60001): left: category / search / list / place; right: faction / preview / details.
class RscDisplayVehicle: FAC_Terminal {
    idd = 60001;
    onLoad = "0 spawn { private _d = findDisplay 60001; if (!isNull _d) then { ['onLoadVehicle', [_d]] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]); }; };";
};


// Manage Missions dialog -- tabbed: Browse | Active slots
class RscDisplayMissions: FAC_Terminal {
    idd = 60002;
    onLoad = "[] spawn { sleep 0.01; ['onLoad', []] call (missionNamespace getVariable ['FAC_missionsGui_fnc', {}]); };";
};


// Manage Scenario — header tabs (Vehicle-style) + Scenario / Weather / Factions / Admin panels
class RscDisplayScenario: FAC_Terminal {
    idd = 60003;
    onLoad = "0 spawn { private _d = findDisplay 60003; if (!isNull _d) then { ['onLoad', [_d]] call (missionNamespace getVariable ['FAC_scenarioGui_fnc', {}]); }; };";
};


