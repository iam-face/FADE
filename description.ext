        class ActiveSlotGlobal: RscEdit { idc = 60130; x = 0.04; y = 0.591; w = 0.224; h = 0.125; style = 16; sizeEx = 0.032; colorText[] = {0.9, 0.9, 0.9, 1}; colorDisabled[] = {0.9, 0.9, 0.9, 1}; colorBackground[] = {0.06, 0.08, 0.07, 0.92}; text = ""; };
