        class AmmoSlider: RscXSliderH { idc = 61221; show = 0; x = 0.455; y = 0.596; w = 0.355; h = 0.022; onSliderPosChanged = "['manageAmmoSliderChanged', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
