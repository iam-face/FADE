// Manage Missions dialog -- list + description, no map (map control caused crashes)
class RscDisplayMissions: RscDisplayEmpty {
    idd = 60002;
    movingEnable = 1;
    enableSimulation = 1;
    onLoad = "[] spawn { sleep 0.01; ['onLoad', []] call (missionNamespace getVariable ['FAC_missionsGui_fnc', {}]); };";
    class controlsBackground {
        // Keep the container tight to the bottom abort buttons (removes dead space below slot panels).
        class Background: RscText { idc = -1; x = 0.02; y = 0.02; w = 0.96; h = 0.845; colorBackground[] = {0.1, 0.1, 0.15, 0.95}; };
        class Title: RscText { idc = -1; text = "MANAGE MISSIONS"; x = 0.02; y = 0.02; w = 0.96; h = 0.05; colorBackground[] = {0.2, 0.4, 0.6, 1}; colorText[] = {1, 1, 1, 1}; sizeEx = 0.05; };
    };
    class controls {
        // Global vs single helper - RscEdit multiline (StructuredText often draws nothing in this dialog)
        class MissionRulesText: RscEdit { idc = 60133; x = 0.04; y = 0.078; w = 0.92; h = 0.155; style = 528; sizeEx = 0.03; colorText[] = {0.55, 0.82, 0.62, 1}; colorDisabled[] = {0.55, 0.82, 0.62, 1}; colorBackground[] = {0, 0, 0, 0}; colorSelection[] = {0.12, 0.28, 0.2, 0.35}; text = ""; };
        class MissionLabel: RscText { idc = 60110; text = "Select mission"; x = 0.04; y = 0.238; w = 0.28; h = 0.028; sizeEx = 0.032; };
        class MissionList: RscListBox { idc = 60120; x = 0.04; y = 0.268; w = 0.28; h = 0.285; rowHeight = 0.038; sizeEx = 0.032; onLBSelChanged = "['missionSelChanged', []] call (missionNamespace getVariable ['FAC_missionsGui_fnc', {}]); ['updateButtons', []] call (missionNamespace getVariable ['FAC_missionsGui_fnc', {}]);"; };
        class DescLabel: RscText { idc = 60111; text = "Description"; x = 0.33; y = 0.238; w = 0.30; h = 0.028; sizeEx = 0.032; };
        class DescText: RscEdit { idc = 60131; x = 0.33; y = 0.268; w = 0.63; h = 0.285; style = 16; sizeEx = 0.032; colorText[] = {0.9, 0.9, 0.9, 1}; colorDisabled[] = {0.9, 0.9, 0.9, 1}; colorBackground[] = {0.08, 0.08, 0.12, 0.9}; text = ""; };
        // Active slots: column headers (G1 / S1â€“S3) + status boxes (plain text via script)
