        class MissionList: RscListBox { idc = 60120; x = 0.04; y = 0.13; w = 0.28; h = 0.44; rowHeight = 0.038; sizeEx = 0.032; onLBSelChanged = "['missionSelChanged', []] call (missionNamespace getVariable ['FAC_missionsGui_fnc', {}]); ['updateButtons', []] call (missionNamespace getVariable ['FAC_missionsGui_fnc', {}]);"; };
        class StartMissionBtn: RscButton { idc = 60121; text = "START MISSION"; x = 0.04; y = 0.60; w = 0.28; h = 0.045; sizeEx = 0.035; action = "['startMission', []] call (missionNamespace getVariable ['FAC_missionsGui_fnc', {}]);"; };
