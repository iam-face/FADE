class Header {
    gameType = "Sandbox";
    minPlayers = 1;
    maxPlayers = 32;
};

// Respawn: override mission.sqm to avoid respawn on mission start (no script calls forceRespawn).
// 0 = none; set to 3 in Eden for base respawn on death if desired.
respawn = 3;
respawnTemplates[] = { "Spectator" };
respawnOnStart = 0;

// Face's Dynamic Sandbox GUI -- base controls (import can fail with some mod combinations)
#include "rsc\BaseControls.hpp"

// Display base -- must be defined before use (game class can be undefined with mod combos)
class RscDisplayEmpty { idd = -1; movingEnable = 1; enableSimulation = 1; };

// Manage Vehicles dialog -- larger, easier to use, aligned buttons (layout aligned with Missions/Scenario)
class RscDisplayVehicle: RscDisplayEmpty {
    idd = 60001;
    movingEnable = 1;
    enableSimulation = 1;
    onLoad = "[] spawn { sleep 0.01; ['onLoad', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]); };";
    class controlsBackground {
        class Background: RscText { idc = -1; x = 0.02; y = 0.02; w = 0.96; h = 0.96; colorBackground[] = {0.1, 0.1, 0.15, 0.95}; };
        class Title: RscText { idc = -1; text = "MANAGE VEHICLES"; x = 0.02; y = 0.02; w = 0.96; h = 0.05; colorBackground[] = {0.2, 0.4, 0.6, 1}; colorText[] = {1, 1, 1, 1}; sizeEx = 0.05; };
    };
    class controls {
        // Filter row: labels above boxes. Faction 50% wider, Search moved right
        class CatLabel: RscText { idc = -1; text = "Type"; x = 0.03; y = 0.07; w = 0.14; h = 0.03; sizeEx = 0.032; };
        class CatList: RscListBox { idc = 60170; x = 0.03; y = 0.10; w = 0.14; h = 0.10; rowHeight = 0.045; sizeEx = 0.035; onLBSelChanged = "['categoryChanged', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class FactionLabel: RscText { idc = -1; text = "Faction"; x = 0.19; y = 0.07; w = 0.42; h = 0.03; sizeEx = 0.032; };
        class FactionList: RscListBox { idc = 60181; x = 0.19; y = 0.10; w = 0.42; h = 0.10; rowHeight = 0.045; sizeEx = 0.035; onLBSelChanged = "['filterChanged', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class SearchLabel: RscText { idc = -1; text = "Search"; x = 0.63; y = 0.07; w = 0.20; h = 0.03; sizeEx = 0.032; };
        class SearchEdit: RscEdit { idc = 60180; x = 0.63; y = 0.10; w = 0.33; h = 0.045; sizeEx = 0.035; onKeyUp = "['filterChanged', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        // Left panel: Select vehicle + preview (no vehicle info box)
        class VehicleListLabel: RscText { idc = -1; text = "Select vehicle"; x = 0.03; y = 0.22; w = 0.46; h = 0.03; sizeEx = 0.03; };
        class VehicleList: RscListBox { idc = 60100; x = 0.03; y = 0.25; w = 0.46; h = 0.48; rowHeight = 0.038; sizeEx = 0.033; onLBSelChanged = "['heliSel', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]); ['updateButtons', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class VehiclePreview: RscPicture { idc = 60101; x = 0.03; y = 0.75; w = 0.18; h = 0.12; text = ""; colorBackground[] = {0.08, 0.08, 0.12, 0.9}; };
        class SpawnBtn: RscButton { idc = 60102; text = "Spawn selected"; x = 0.03; y = 0.89; w = 0.46; h = 0.045; sizeEx = 0.038; action = "['spawn', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        // Right panel: Vehicles at base (same height as left list)
        class SpawnedLabel: RscText { idc = -1; text = "Vehicles at base"; x = 0.51; y = 0.22; w = 0.46; h = 0.03; sizeEx = 0.03; };
        class SpawnedList: RscListBox { idc = 60110; x = 0.51; y = 0.25; w = 0.46; h = 0.48; rowHeight = 0.038; sizeEx = 0.033; onLBSelChanged = "['updateButtons', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class DespawnBtn: RscButton { idc = 60111; text = "Despawn selected"; x = 0.51; y = 0.89; w = 0.46; h = 0.045; sizeEx = 0.038; action = "['despawn', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class CloseBtn: RscButton { idc = 60140; text = "CLOSE"; x = 0.84; y = 0.93; w = 0.14; h = 0.045; sizeEx = 0.038; action = "closeDialog 0;"; };
    };
};

// Manage Missions dialog -- list + description, no map (map control caused crashes)
