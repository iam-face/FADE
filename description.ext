        // Bottom: status + close
        class StatusLabel: RscText { idc = -1; text = "Status:"; x = 0.04; y = 0.78; w = 0.06; h = 0.03; sizeEx = 0.032; };
        class StatusText: RscText { idc = 60130; text = "No mission active"; x = 0.11; y = 0.78; w = 0.55; h = 0.03; sizeEx = 0.032; colorText[] = {0.7, 0.9, 0.7, 1}; };
        class CloseBtn: RscButton { idc = 60140; text = "CLOSE"; x = 0.82; y = 0.90; w = 0.14; h = 0.045; sizeEx = 0.038; action = "closeDialog 0;"; };
    };
};

