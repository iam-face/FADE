class Header {
    gameType = "Sandbox";
    minPlayers = 1;
    maxPlayers = 31;  // match playable slots in mission.sqm (avoids role count vs maxPlayers warning)
};

class Params
{
    class FAC_MissionsGuiAccess
    {
        title = "Missions GUI access";
        values[] = {0, 1};
        texts[] = {"All players", "Group leaders only (admin/Zeus override)"};
        default = 0;
    };
    class FAC_ScenarioGuiAccess
    {
        title = "Scenario GUI access";
        values[] = {0, 1};
        texts[] = {"All players", "Group leaders only (admin/Zeus override)"};
        default = 0;
    };
    class FAC_EnableAceArsenalActions
    {
        title = "Loadout box ACE Arsenal action";
        values[] = {0, 1};
        texts[] = {"Disabled", "Enabled"};
        default = 1;
    };
};

// Respawn: override mission.sqm to avoid respawn on mission start (no script calls forceRespawn).
// 0 = none; set to 3 in Eden for base respawn on death if desired.
respawn = 3;
respawnTemplates[] = { "Spectator" };
respawnOnStart = 0;

// Unlocks ESC menu: Splendid Camera + Spectator (same debug-console block; default MP hides them)
enableDebugConsole = 2;

// bis_fnc_cp_* stubs before Eden CP/CPE modules (see rsc\fn_bisCpPreInit.sqf)
#include "rsc\CfgFunctionsMission.hpp"

// Face's Dynamic Sandbox GUI -- base controls (import can fail with some mod combinations)
#include "rsc\BaseControls.hpp"

// Display base -- must be defined before use (game class can be undefined with mod combos)
class RscDisplayEmpty { idd = -1; movingEnable = 1; enableSimulation = 1; };

// Vehicles — single dialog (60001): mockup layout — left: category / search / list / spawn / pads; right: faction / preview / details.
class RscDisplayVehicle: RscDisplayEmpty {
    idd = 60001;
    movingEnable = 1;
    enableSimulation = 1;
    // Next-frame init so findDisplay 60001 is valid; manage controls use show=0 until setTab (no spawn/manage overlap).
    onLoad = "0 spawn { private _d = findDisplay 60001; if (!isNull _d) then { ['onLoadVehicle', [_d]] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]); }; };";
    class controlsBackground {
        // Tighter frame: content stacks to ~0.86; avoids large dead band at bottom on both tabs.
        class Background: RscText { idc = -1; x = 0.02; y = 0.025; w = 0.96; h = 0.855; colorBackground[] = {0.05, 0.06, 0.09, 0.98}; };
    };
    class controls {
        class MainContentPanel: RscText { idc = 61901; x = 0.03; y = 0.092; w = 0.94; h = 0.768; colorBackground[] = {0.03, 0.04, 0.07, 0.55}; };
        // --- Spawn (New): left column ---
        class BtnCatAircraft: RscButton { idc = 61116; text = "Aircraft"; x = 0.04; y = 0.105; w = 0.395; h = 0.042; sizeEx = 0.032; colorBackground[] = {0.22, 0.48, 0.78, 1}; colorText[] = {1, 1, 1, 1}; action = "['spawnCategorySet', ['aircraft']] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class BtnCatLand: RscButton { idc = 61117; text = "Land Vehicles"; x = 0.04; y = 0.153; w = 0.395; h = 0.042; sizeEx = 0.03; colorBackground[] = {0.07, 0.11, 0.20, 1}; colorText[] = {0.95, 0.95, 0.95, 1}; action = "['spawnCategorySet', ['land']] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class SearchLabel: RscText { idc = 61112; text = "Search..."; x = 0.04; y = 0.205; w = 0.395; h = 0.020; sizeEx = 0.024; colorText[] = {0.65, 0.68, 0.75, 1}; };
        class SearchEdit: RscEdit { idc = 61102; x = 0.04; y = 0.228; w = 0.395; h = 0.036; sizeEx = 0.028; colorBackground[] = {0.02, 0.03, 0.05, 0.95}; colorText[] = {0.95, 0.95, 0.95, 1}; onKeyUp = "['spawnFilterChanged', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class VehicleListLabel: RscText { idc = 61113; text = "Select vehicle"; x = 0.04; y = 0.272; w = 0.395; h = 0.020; sizeEx = 0.024; colorText[] = {0.65, 0.68, 0.75, 1}; };
        class VehicleList: RscListBox { idc = 61103; x = 0.04; y = 0.295; w = 0.395; h = 0.355; rowHeight = 0.034; sizeEx = 0.028; colorBackground[] = {0.02, 0.03, 0.05, 0.95}; colorSelectBackground[] = {0.15, 0.35, 0.55, 0.75}; onLBSelChanged = "['spawnVehicleSel', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class SpawnBtn: RscButton { idc = 61107; text = "Spawn"; x = 0.04; y = 0.658; w = 0.395; h = 0.048; sizeEx = 0.034; colorBackground[] = {0.22, 0.48, 0.78, 1}; colorBackgroundActive[] = {0.28, 0.55, 0.88, 1}; action = "['spawn', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class PadListLabel: RscText { idc = 61114; text = "Spawn location"; x = 0.04; y = 0.714; w = 0.395; h = 0.020; sizeEx = 0.024; colorText[] = {0.65, 0.68, 0.75, 1}; };
        class PadList: RscListBox { idc = 61106; x = 0.04; y = 0.737; w = 0.395; h = 0.135; rowHeight = 0.030; sizeEx = 0.026; colorBackground[] = {0.02, 0.03, 0.05, 0.95}; colorSelectBackground[] = {0.15, 0.35, 0.55, 0.75}; onLBSelChanged = "['spawnPadSel', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        // --- Spawn: right column (faction filter, preview, details) ---
        class FactionList: RscListBox { idc = 61101; x = 0.455; y = 0.105; w = 0.505; h = 0.125; rowHeight = 0.032; sizeEx = 0.027; colorBackground[] = {0.02, 0.03, 0.05, 0.95}; colorSelectBackground[] = {0.15, 0.35, 0.55, 0.75}; onLBSelChanged = "['spawnFilterChanged', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class VehiclePreview: RscPicture { idc = 61104; x = 0.455; y = 0.242; w = 0.505; h = 0.288; text = ""; style = 48; colorBackground[] = {0.12, 0.13, 0.16, 1}; };
        class DetailsLabelSpawn: RscText { idc = 61115; text = "Details"; x = 0.455; y = 0.538; w = 0.505; h = 0.020; sizeEx = 0.024; colorText[] = {0.65, 0.68, 0.75, 1}; };
