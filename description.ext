        // --- Manage (Existing): list + tall preview (left, to footer row); details + ammo + fuel/health + quick row; Despawn/Duplicate right column only (x = Quick repair) ---
        class SpawnedLabel: RscText { idc = 61240; show = 0; text = "Selected vehicle"; x = 0.04; y = 0.105; w = 0.395; h = 0.020; sizeEx = 0.024; colorText[] = {0.92, 0.93, 0.95, 1}; };
        class SpawnedList: RscListBox { idc = 61200; show = 0; x = 0.04; y = 0.128; w = 0.395; h = 0.328; rowHeight = 0.034; sizeEx = 0.028; colorBackground[] = {0.02, 0.03, 0.05, 0.95}; colorSelectBackground[] = {0.15, 0.35, 0.55, 0.75}; onLBSelChanged = "['manageVehicleSel', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
