        class DetailsLabelManage: RscText { idc = 61241; show = 0; text = "Selected vehicle details"; x = 0.455; y = 0.105; w = 0.505; h = 0.020; sizeEx = 0.024; colorText[] = {0.92, 0.93, 0.95, 1}; };
        class VehicleDetailsManage: RscListBoxVehicleDetails { idc = 61211; show = 0; x = 0.455; y = 0.128; w = 0.505; h = 0.248; rowHeight = 0.026; sizeEx = 0.025; colorBackground[] = {0.02, 0.03, 0.05, 0.95}; };
        class AmmoTypeLabel: RscText { idc = 61242; show = 0; text = "Ammo"; x = 0.455; y = 0.382; w = 0.505; h = 0.018; sizeEx = 0.022; colorText[] = {0.65, 0.68, 0.75, 1}; };
