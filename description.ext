// Loadout -- top-level class for createDialog (CfgDisplay can fail with mod conflicts)
// Layout: full width (99%), unit list 96% wide (tooltip shows loadout on hover)
class RscDisplayLoadout: RscDisplayEmpty {
    idd = 60200;
    movingEnable = 1;
    enableSimulation = 1;
    onLoad = "[] spawn { sleep 0.01; ['onLoad', []] call (missionNamespace getVariable ['FAC_loadoutGui_fnc', {}]); };";
    class controlsBackground {
        class Background: RscText { idc = -1; x = 0.005; y = 0.02; w = 0.99; h = 0.96; colorBackground[] = {0.1, 0.1, 0.15, 0.95}; };
        class Title: RscText { idc = -1; text = "MANAGE MY LOADOUT"; x = 0.005; y = 0.02; w = 0.99; h = 0.05; colorBackground[] = {0.2, 0.4, 0.6, 1}; colorText[] = {1, 1, 1, 1}; sizeEx = 0.05; };
    };
    class controls {
        // Unit list + filters (full width)
        class UnitListLabel: RscText { idc = -1; text = "Choose my loadout:"; x = 0.02; y = 0.09; w = 0.96; h = 0.03; sizeEx = 0.032; };
        class UnitList: RscListBox { idc = 60201; x = 0.02; y = 0.13; w = 0.96; h = 0.52; rowHeight = 0.038; sizeEx = 0.035; onLBSelChanged = "['unitSelChanged', []] call (missionNamespace getVariable ['FAC_loadoutGui_fnc', {}]);"; };
        // Faction list: 40% of unit list width (0.96 * 0.4 = 0.384), left-aligned with unit list; search row shares top y
        class FactionList: RscListBox { idc = 60210; x = 0.02; y = 0.66; w = 0.384; h = 0.17; rowHeight = 0.042; sizeEx = 0.038; onLBSelChanged = "['filterChanged', []] call (missionNamespace getVariable ['FAC_loadoutGui_fnc', {}]);"; };
        class SearchLabel: RscText { idc = -1; text = "Search:"; x = 0.414; y = 0.66; w = 0.08; h = 0.04; sizeEx = 0.032; };
        class SearchEdit: RscEdit { idc = 60211; x = 0.504; y = 0.66; w = 0.476; h = 0.04; onKeyUp = "['filterChanged', []] call (missionNamespace getVariable ['FAC_loadoutGui_fnc', {}]);"; };
        class Add343Btn: RscButton { idc = 60207; text = "ADD 343"; x = 0.52; y = 0.83; w = 0.22; h = 0.04; action = "['addRadio343', []] call (missionNamespace getVariable ['FAC_loadoutGui_fnc', {}]);"; };
        class Add152Btn: RscButton { idc = 60208; text = "ADD 152"; x = 0.76; y = 0.83; w = 0.22; h = 0.04; action = "['addRadio152', []] call (missionNamespace getVariable ['FAC_loadoutGui_fnc', {}]);"; };
        class ApplyBtn: RscButton { idc = 60202; text = "APPLY TO ME"; x = 0.02; y = 0.88; w = 0.22; h = 0.04; action = "['apply', []] call (missionNamespace getVariable ['FAC_loadoutGui_fnc', {}]);"; };
        class SaveBtn: RscButton { idc = 60204; text = "SAVE LOADOUT"; x = 0.26; y = 0.88; w = 0.24; h = 0.04; action = "['saveLoadout', []] call (missionNamespace getVariable ['FAC_loadoutGui_fnc', {}]);"; };
        class RestoreBtn: RscButton { idc = 60206; text = "RESTORE SAVED"; x = 0.52; y = 0.88; w = 0.24; h = 0.04; action = "['restoreLoadout', []] call (missionNamespace getVariable ['FAC_loadoutGui_fnc', {}]);"; };
        class CloseBtn: RscButton { idc = 60203; text = "CLOSE"; x = 0.78; y = 0.88; w = 0.20; h = 0.04; action = "closeDialog 0;"; };
        class SavedStatusLabel: RscText { idc = 60205; text = ""; x = 0.02; y = 0.93; w = 0.96; h = 0.03; sizeEx = 0.028; };
    };
};

