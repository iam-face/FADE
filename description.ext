        class BtnCatLand: RscButton { idc = 61117; text = "Land Vehicles"; x = 0.04; y = 0.153; w = 0.395; h = 0.042; sizeEx = 0.03; colorBackground[] = {0.07, 0.11, 0.20, 1}; colorText[] = {0.95, 0.95, 0.95, 1}; action = "['spawnCategorySet', ['land']] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class FACWhitelistBtn: RscButton { idc = 61118; text = "Aircraft whitelist: ON"; x = 0.04; y = 0.198; w = 0.395; h = 0.038; sizeEx = 0.026; colorBackground[] = {0.12, 0.22, 0.38, 1}; colorText[] = {0.95, 0.95, 0.95, 1}; action = "['spawnWhitelistClick', []] call (missionNamespace getVariable ['FAC_vehicleGui_fnc', {}]);"; };
        class SearchLabel: RscText { idc = 61112; text = "Search..."; x = 0.04; y = 0.244; w = 0.395; h = 0.020; sizeEx = 0.024; colorText[] = {0.65, 0.68, 0.75, 1}; };
